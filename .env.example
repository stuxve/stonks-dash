# Copy to .env and adjust. docker compose reads it automatically.
STONKS_BIND=127.0.0.1
STONKS_PORT=8000
STONKS_PROVIDER=yahoo
STONKS_QUOTE_TTL=60
TZ=Europe/Madrid
# Telegram alerts (Sell targets): token from @BotFather. Optional — it can also be pasted in the app.
TELEGRAM_BOT_TOKEN=
# Long revenue / profit history (Analysis tab) comes from SEC EDGAR, which asks API users to identify themselves.
# If the chart says the SEC refused (403), put your name and an email here, e.g. STONKS_SEC_UA=Jane Doe jane@example.com
STONKS_SEC_UA=
